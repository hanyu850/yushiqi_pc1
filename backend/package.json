{
  "name": "yushiqi-ai-backend",
  "version": "3.0.0",
  "description": "羽世奇 AI - Node.js + Express 后端服务",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "build": "pkg . --targets node18-win-x64,node18-linux-x64 --output dist/",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.0",
    "mysql2": "^3.6.0",
    "sequelize": "^6.35.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "pkg": "^5.8.1",
    "eslint": "^8.57.0"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "src/config/*",
      "node_modules/sequelize/lib/dialects/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  }
}
